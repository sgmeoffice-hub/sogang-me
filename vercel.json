{
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "routes": [
    {
      "src": "^/(?:v2/)?bbs(?:/.*)?$",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(Googlebot|Google-InspectionTool|Yeti|bingbot|Daum|kakaotalk-scrap|OAI-SearchBot|ChatGPT-User|PerplexityBot|Perplexity-User|Claude-SearchBot|Claude-User).*"
          }
        }
      ],
      "mitigate": {
        "action": "challenge"
      },
      "continue": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/translate",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 19 * * *"
    }
  ]
}
