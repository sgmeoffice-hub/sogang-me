{
  "ignoreCommand": "git rev-parse -q --verify \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" >/dev/null 2>&1 && git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ':(exclude)docs' ':(exclude)*.md' ':(exclude)scripts' ':(exclude)supabase'",
  "routes": [
    {
      "src": "^/(?:v2/)?bbs(?:/.*)?$",
      "mitigate": { "action": "challenge" },
      "continue": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/translate",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 19 * * *"
    }
  ]
}
