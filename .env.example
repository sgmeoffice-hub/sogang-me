# 코드가 읽는 환경변수 전체 목록(2026-10-13). Vercel › Settings › Environment Variables에 같은 이름으로 넣는다(값 변경 후 재배포 필요).
# README·docs/ADMIN-HANDOVER.md는 이 파일을 가리킨다 — 변수를 추가하면 여기를 먼저 갱신할 것. 값은 리포(공개)에 절대 넣지 않는다.

# ── 필수: Supabase (Project Settings › API) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role: 백업·휴지통·cron·관리자 서버 코드만 사용(브라우저에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── 사이트 ────────────────────────────────────────────────────────────────
# 관리자 화면 주소: https://<도메인>/<ADMIN_PATH> (기본 adm)
ADMIN_PATH=adm
# 공개 주소(사이트맵·robots·canonical·알림 메일 링크). 사이트맵·robots는 없으면 https://me.sogang.ac.kr, 알림 메일 링크는 빈 값이 됨 — 넣을 것
NEXT_PUBLIC_SITE_URL=https://me.sogang.ac.kr
# Vercel Cron(/api/cron/translate·backup) 인증 토큰 — 필수. Vercel에 설정하면 cron 호출에 Bearer를 자동으로 붙인다. 없으면 cron이 503으로 멈춘다
CRON_SECRET=

# ── 백업(Cloudflare R2, lib/r2.ts) — 없으면 자동 백업이 '설정 필요'로 건너뜀 ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 백업 비공개 버킷(예: sogang-me-backup)
R2_BACKUP_BUCKET=
# (선택) 옛 홈페이지 파일 공개 버킷 — 기본 sogang-me-media
R2_MEDIA_BUCKET=

# ── 알림 메일(Resend, lib/notify.ts) — 없으면 접수만 되고 메일 생략 ──────────
RESEND_API_KEY=
# (선택) /adm 설정의 알림 이메일이 비었을 때 쓰는 수신자
NOTIFY_EMAIL=
# (선택) 발신자. 기본 'Sogang ME <onboarding@resend.dev>'(테스트 발신자 — 학과 Gmail로만 발송 가능). me.sogang.ac.kr 도메인 인증 후 변경
NOTIFY_FROM=

# ── 번역(lib/translate.ts) ────────────────────────────────────────────────
# 비우면 무료 번역기(Google 웹 엔드포인트 / MyMemory). 키를 넣으면 코드 수정 없이 Claude 번역으로 전환(유료)
ANTHROPIC_API_KEY=
# (선택) Claude 모델 ID — 기본값은 lib/translate.ts
ANTHROPIC_MODEL=
# MyMemory 예비 번역기에 보내는 연락 이메일(일일 한도 확대용)
TRANSLATE_CONTACT_EMAIL=me@sogang.ac.kr

# Claude Code 환경(Environment)에만 두는 것(Vercel 불필요): SUPABASE_URL·SUPABASE_SERVICE_ROLE_KEY(복원·일괄 작업 스크립트),
# VERCEL_TOKEN(Vercel 사용량·방화벽 조회 — docs/OPERATIONS.md §3).
